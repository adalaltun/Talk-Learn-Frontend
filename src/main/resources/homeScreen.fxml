<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<SplitPane dividerPositions="0.28" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.HomeController">
    <items>

        <AnchorPane minHeight="-Infinity" minWidth="-Infinity" prefWidth="220.0">
            <children>

                <StackPane AnchorPane.bottomAnchor="160.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="15.0">
                    <children>


                        <VBox fx:id="profileView" alignment="CENTER" spacing="5.0" visible="true">
                            <children>
                                <StackPane prefHeight="80.0" prefWidth="80.0">
                                    <children>
                                        <Circle fill="#e6e6fa" radius="40.0" stroke="#6a5acd" strokeType="INSIDE" strokeWidth="1.5" />
                                        <Label style="-fx-font-size: 36px; -fx-text-fill: #6a5acd;" />
                                    </children>
                                </StackPane>
                                <Label style="-fx-font-weight: bold;" text="Username" />
                                <Label style="-fx-text-fill: gray;" text="Rank" />
                            </children>
                        </VBox>


                        <ScrollPane fx:id="myMeetupsListView" fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: transparent;" vbarPolicy="AS_NEEDED" visible="false">
                            <VBox spacing="15.0" style="-fx-padding: 0 5 0 0;">
                                <children>
                                    <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-underline: true;" text="My Meetups :" />

                                    <!-- Planned Section -->
                                    <VBox spacing="8.0">
                                        <children>
                                            <Label style="-fx-font-size: 14px; -fx-underline: true;" text="Planned :" />
                                            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handlePlannedMeetupClick" style="-fx-background-color: #a9a9a9; -fx-background-radius: 20; -fx-text-fill: black; -fx-font-weight: bold; -fx-padding: 6;" text="Meet-up" />
                                        </children>
                                    </VBox>


                                    <VBox spacing="8.0">
                                        <children>
                                            <Label style="-fx-font-size: 14px; -fx-underline: true;" text="Old :" />
                                            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleOldMeetupClick" style="-fx-background-color: #d3d3d3; -fx-background-radius: 20; -fx-text-fill: #333; -fx-padding: 6;" text="Pizza Night" />
                                            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleOldMeetupClick" style="-fx-background-color: #d3d3d3; -fx-background-radius: 20; -fx-text-fill: #333; -fx-padding: 6;" text="Jung Talks" />
                                        </children>
                                    </VBox>
                                </children>
                            </VBox>
                        </ScrollPane>

                    </children>
                </StackPane>


                <VBox spacing="5.0" AnchorPane.bottomAnchor="45.0" AnchorPane.leftAnchor="5.0" AnchorPane.rightAnchor="5.0">
                    <children>
                        <Button mnemonicParsing="false" onAction="#handleCreateMeetup" prefHeight="32.0" prefWidth="250.0" text="Create new ad" />
                        <Button mnemonicParsing="false" onAction="#handleMyMeetups" prefHeight="32.0" prefWidth="250.0" text="My ads" />
                        <Button mnemonicParsing="false" onAction="#handleSavedMeetups" prefHeight="32.0" prefWidth="250.0" text="Favourites" />
                    </children>
                </VBox>


                <HBox spacing="5.0" AnchorPane.bottomAnchor="5.0" AnchorPane.leftAnchor="5.0" AnchorPane.rightAnchor="5.0">
                    <children>
                        <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleMain" text="H" HBox.hgrow="ALWAYS" />
                        <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleDiscovery" text="D" HBox.hgrow="ALWAYS" />
                        <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleChat" text="C" HBox.hgrow="ALWAYS" />
                        <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleLeaderboard" text="R" HBox.hgrow="ALWAYS" />
                        <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleSettings" text="S" HBox.hgrow="ALWAYS" />
                    </children>
                </HBox>
            </children>
        </AnchorPane>


        <AnchorPane fx:id="contentArea" minHeight="0.0" minWidth="450.0" />
    </items>
</SplitPane>