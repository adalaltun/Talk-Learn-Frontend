<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <VBox spacing="20.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
            <children>
                <HBox spacing="20.0">
                    <children>
                        <TextField alignment="CENTER" promptText="Title" HBox.hgrow="ALWAYS" />
                        <TextField alignment="CENTER" promptText="Language" HBox.hgrow="ALWAYS" />
                    </children>
                </HBox>

                <TextArea prefHeight="120.0" promptText="Description" />

                <VBox spacing="10.0">
                    <children>
                        <Label text="Meeting Location :" underline="true" />
                        <HBox spacing="15.0">
                            <children>
                                <VBox alignment="CENTER" spacing="5.0">
                                    <children>
                                        <Region prefHeight="60.0" prefWidth="90.0" style="-fx-border-color: black;" />
                                        <Label text="Library" />
                                    </children>
                                </VBox>
                                <VBox alignment="CENTER" spacing="5.0">
                                    <children>
                                        <Region prefHeight="60.0" prefWidth="90.0" style="-fx-border-color: black;" />
                                        <Label text="Bilka" />
                                    </children>
                                </VBox>
                                <VBox alignment="CENTER" spacing="5.0">
                                    <children>
                                        <Region prefHeight="60.0" prefWidth="90.0" style="-fx-border-color: black;" />
                                        <Label alignment="CENTER" text="S Building&#10;Pool" textAlignment="CENTER" />
                                    </children>
                                </VBox>
                                <VBox alignment="CENTER" spacing="5.0">
                                    <children>
                                        <Region prefHeight="60.0" prefWidth="90.0" style="-fx-border-color: black;" />
                                        <Label text="Cafeteria" />
                                    </children>
                                </VBox>
                                <Label text="...">
                                    <padding>
                                        <Insets top="25.0" />
                                    </padding>
                                </Label>
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <VBox spacing="10.0">
                    <children>
                        <Label text="Add Tags :" underline="true" />
                        <HBox spacing="10.0">
                            <children>
                                <Region prefHeight="30.0" prefWidth="70.0" style="-fx-background-color: #d3d3d3;" />
                                <Region prefHeight="30.0" prefWidth="70.0" style="-fx-background-color: #d3d3d3;" />
                                <Region prefHeight="30.0" prefWidth="70.0" style="-fx-background-color: #d3d3d3;" />
                                <Region prefHeight="30.0" prefWidth="70.0" style="-fx-background-color: #d3d3d3;" />
                                <Label text="...">
                                    <padding>
                                        <Insets top="5.0" />
                                    </padding>
                                </Label>
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</AnchorPane>