<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<?import javafx.scene.control.DatePicker?>
<AnchorPane minHeight="0.0" minWidth="450.0" prefHeight="600.0" prefWidth="650.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.HomeController">
    <children>

        <VBox layoutX="25.0" layoutY="25.0" spacing="24.0" AnchorPane.leftAnchor="25.0" AnchorPane.rightAnchor="25.0" AnchorPane.topAnchor="25.0">
            <children>

                <Label text="Create New Meetup" textFill="#1a1a1a">
                    <font>
                        <Font name="System Bold" size="22.0" />
                    </font>
                </Label>

                <HBox spacing="20.0">
                    <children>
                        <TextField fx:id="meetupTitleInput" prefHeight="40.0" promptText="Title" style="-fx-background-color: #f5f5f5; -fx-background-radius: 10; -fx-border-color: #e0e0e0; -fx-border-radius: 10; -fx-padding: 0 15 0 15;" HBox.hgrow="ALWAYS" />

                        <ComboBox fx:id="languageComboBox" prefHeight="40.0" prefWidth="200.0" promptText="Language" style="-fx-background-color: #f5f5f5; -fx-background-radius: 10; -fx-border-color: #e0e0e0; -fx-border-radius: 10; -fx-padding: 0 5 0 5;" HBox.hgrow="ALWAYS">
                            <items>
                                <FXCollections fx:factory="observableArrayList">
                                    <String fx:value="English" />
                                    <String fx:value="Turkish" />
                                    <String fx:value="German" />
                                    <String fx:value="French" />
                                    <String fx:value="Spanish" />
                                </FXCollections>
                            </items>
                        </ComboBox>
                        <DatePicker fx:id="meetupDatePicker" prefHeight="40.0" prefWidth="200.0" promptText="Meetup Date" HBox.hgrow="ALWAYS"
                                    style="-fx-background-color: #f5f5f5; -fx-background-radius: 10; -fx-border-color: #e0e0e0; -fx-border-radius: 10;" />
                    </children>
                </HBox>

                <TextArea fx:id="meetupDescriptionInput" prefHeight="140.0" promptText="Describe what you will talk about..." style="-fx-control-inner-background: #f5f5f5; -fx-background-color: transparent; -fx-text-box-border: #e0e0e0; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 5;" wrapText="true" />

                <VBox spacing="12.0">
                    <children>
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #4d4d4d;" text="Meeting Location">
                            <font>
                                <Font size="14.0" />
                            </font></Label>

                        <HBox spacing="12.0">
                            <children>
                                <fx:define>
                                    <ToggleGroup fx:id="locationToggleGroup" />
                                </fx:define>

                                <ToggleButton mnemonicParsing="false" prefHeight="45.0" prefWidth="100.0" style="-fx-background-color: #f5f5f5; -fx-font-weight: bold; -fx-background-radius: 20; -fx-border-color: #cccccc; -fx-border-radius: 20; -fx-cursor: hand;" text="Library">
                           <toggleGroup>
                              <ToggleGroup fx:id="locationToggleGroup" />
                           </toggleGroup></ToggleButton>
                                <ToggleButton mnemonicParsing="false" prefHeight="45.0" prefWidth="100.0" style="-fx-background-color: #f5f5f5; -fx-font-weight: bold; -fx-background-radius: 20; -fx-border-color: #cccccc; -fx-border-radius: 20; -fx-cursor: hand;" text="Bilka" toggleGroup="$locationToggleGroup" />
                                <ToggleButton mnemonicParsing="false" prefHeight="45.0" prefWidth="120.0" style="-fx-background-color: #f5f5f5; -fx-background-radius: 20; -fx-border-color: #cccccc; -fx-border-radius: 20; -fx-font-weight: bold; -fx-cursor: hand;" text="S Pool" textAlignment="CENTER" toggleGroup="$locationToggleGroup" wrapText="true" />
                                <ToggleButton mnemonicParsing="false" prefHeight="45.0" prefWidth="100.0" style="-fx-background-color: #f5f5f5; -fx-font-weight: bold; -fx-background-radius: 20; -fx-border-color: #cccccc; -fx-border-radius: 20; -fx-cursor: hand;" text="Cafeteria" toggleGroup="$locationToggleGroup" />
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <VBox spacing="12.0">
                    <children>
                        <Label style="-fx-font-weight: bold; -fx-text-fill: #4d4d4d;" text="Add Tags">
                            <font>
                                <Font size="14.0" />
                            </font></Label>

                        <HBox spacing="12.0">
                            <children>
                                <ToggleButton fx:id="tagGameNight" mnemonicParsing="false" prefHeight="35.0" prefWidth="110.0" style="-fx-background-color: #e3f2fd; -fx-text-fill: #0078fe; -fx-background-radius: 15; -fx-font-weight: bold; -fx-cursor: hand;" text="Game Night" />
                                <ToggleButton fx:id="tagCooking" mnemonicParsing="false" prefHeight="35.0" prefWidth="110.0" style="-fx-background-color: #e3f2fd; -fx-text-fill: #0078fe; -fx-background-radius: 15; -fx-font-weight: bold; -fx-cursor: hand;" text="Cooking" />
                                <ToggleButton fx:id="tagSports" mnemonicParsing="false" prefHeight="35.0" prefWidth="110.0" style="-fx-background-color: #e3f2fd; -fx-text-fill: #0078fe; -fx-background-radius: 15; -fx-font-weight: bold; -fx-cursor: hand;" text="Sports" />
                            </children>
                        </HBox>
                    </children>
                </VBox>

            </children>
        </VBox>

        <Button mnemonicParsing="false" onAction="#handlePublishMeetup" prefHeight="40.0" prefWidth="140.0" style="-fx-background-color: #0078fe; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand;" text="Create" AnchorPane.bottomAnchor="25.0" AnchorPane.rightAnchor="25.0">
            <font>
                <Font size="14.0" />
            </font></Button>
    </children>
</AnchorPane>
