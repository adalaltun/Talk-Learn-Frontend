<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane minHeight="0.0" minWidth="450.0" prefHeight="600.0" prefWidth="650.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.HomeController">
    <children>

        <VBox layoutX="25.0" layoutY="25.0" spacing="20.0" AnchorPane.leftAnchor="25.0" AnchorPane.rightAnchor="25.0" AnchorPane.topAnchor="25.0">
            <children>


                <HBox spacing="20.0">
                    <children>
                        <TextField fx:id="meetupTitleInput" prefHeight="35.0" promptText="Title" HBox.hgrow="ALWAYS" />

                        <ComboBox fx:id="languageComboBox" prefHeight="35.0" prefWidth="200.0" promptText="Language" HBox.hgrow="ALWAYS">
                            <items>
                                <FXCollections fx:factory="observableArrayList">
                                    <String fx:value="English" />
                                    <String fx:value="Turkish" />
                                    <String fx:value="German" />
                                    <String fx:value="French" />
                                    <String fx:value="Spanish" />
                                </FXCollections>
                            </items>
                        </ComboBox>
                    </children>
                </HBox>


                <TextArea fx:id="meetupDescriptionInput" prefHeight="150.0" promptText="Description" wrapText="true" />


                <VBox spacing="10.0">
                    <children>
                        <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-underline: true;" text="Meeting Location :" />

                        <HBox spacing="15.0">
                            <children>
                                <fx:define>
                                    <ToggleGroup fx:id="locationToggleGroup" />
                                </fx:define>

                                <ToggleButton mnemonicParsing="false" prefHeight="60.0" prefWidth="90.0" text="Library" toggleGroup="$locationToggleGroup" />
                                <ToggleButton mnemonicParsing="false" prefHeight="60.0" prefWidth="90.0" text="Bilka" toggleGroup="$locationToggleGroup" />
                                <ToggleButton textAlignment="CENTER" mnemonicParsing="false" prefHeight="60.0" prefWidth="90.0" text="S Building Pool" toggleGroup="$locationToggleGroup" wrapText="true" />
                                <ToggleButton mnemonicParsing="false" prefHeight="60.0" prefWidth="90.0" text="Cafeteria" toggleGroup="$locationToggleGroup" />

                                <Label alignment="BOTTOM_CENTER" prefHeight="60.0" style="-fx-font-size: 18px; -fx-text-fill: gray;" text="..." />
                            </children>
                        </HBox>
                    </children>
                </VBox>


                <VBox spacing="10.0">
                    <children>
                        <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-underline: true;" text="Add Tags :" />

                        <HBox spacing="15.0">
                            <children>
                                <ToggleButton fx:id="tagGameNight" mnemonicParsing="false" prefHeight="35.0" prefWidth="100.0" text="Game Night" />
                                <ToggleButton fx:id="tagCooking" mnemonicParsing="false" prefHeight="35.0" prefWidth="100.0" text="Cooking" />
                                <ToggleButton fx:id="tagSports" mnemonicParsing="false" prefHeight="35.0" prefWidth="100.0" text="Sports" />

                                <Label alignment="BOTTOM_CENTER" prefHeight="35.0" style="-fx-font-size: 18px; -fx-text-fill: gray;" text="..." />
                            </children>
                        </HBox>
                    </children>
                </VBox>

            </children>
        </VBox>


        <Button mnemonicParsing="false" onAction="#handlePublishMeetup"
                prefHeight="35.0" prefWidth="120.0"
                style="-fx-background-color: #6a5acd; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;"
                text="Create"
                AnchorPane.bottomAnchor="25.0"
                AnchorPane.rightAnchor="25.0" />
    </children>
</AnchorPane>