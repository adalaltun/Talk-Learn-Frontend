<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane minHeight="0.0" minWidth="450.0" prefHeight="600.0" prefWidth="650.0" style="-fx-background-color: transparent;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.HomeController">
   <children>
      <ScrollPane fx:id="applicationPane" fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: white; -fx-background: white; -fx-border-color: transparent;" vbarPolicy="AS_NEEDED" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <content>
            <VBox fx:id="applicationsContainer" spacing="18.0" style="-fx-padding: 25.0; -fx-background-color: white;">
               <children>
                  <Label text="Favorite Meetups" textFill="#1a1a1a">
                     <font>
                        <Font name="System Bold" size="22.0" />
                     </font>
                  </Label>
                  <HBox spacing="10.0">
                     <children>
                        <Button mnemonicParsing="false" onAction="#handleListingDetail" style="-fx-background-color: #0099ff; -fx-border-color: transparent; -fx-background-radius: 20; -fx-padding: 10 20 10 20; -fx-focus-color: transparent; -fx-faint-focus-color: transparent;" text="Inspect">
                           <font>
                              <Font name="System Bold" size="14.0" />
                           </font>
                        </Button>
      
                        <!-- Row 3 -->
                        <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: #f5f5f5; -fx-background-radius: 15; -fx-padding: 0 20 0 20; -fx-border-color: #e8e8e8; -fx-border-radius: 15;">
                           <children>
                              <Label fx:id="favListingTitle" style="-fx-font-weight: bold; -fx-text-fill: black;" text="favMeetupTitle1">
                                 <font>
                                    <Font size="16.0" />
                                 </font>
                              </Label>
                              <Label fx:id="favListingLanguage" alignment="CENTER" style="-fx-font-weight: bold; -fx-text-fill: black;" text="favMeetupLang1">
                                 <font>
                                    <Font size="16.0" />
                                 </font>
                              </Label>
                              <Label fx:id="favListingSize" alignment="CENTER_RIGHT" style="-fx-font-weight: bold; -fx-text-fill: black;" text="favMeetupsize1">
                                 <font>
                                    <Font size="16.0" />
                                 </font>
                              </Label>
                           </children>
                        </HBox>
                     </children>
                  </HBox>

               </children>
            </VBox>
         </content>
      </ScrollPane>
   </children>
</AnchorPane>
