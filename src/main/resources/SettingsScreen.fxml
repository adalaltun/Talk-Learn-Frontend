<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>

<SplitPane fx:id="rootPane" dividerPositions="0.32" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity"
           minWidth="-Infinity" prefHeight="600.0" prefWidth="900.0"
           style="-fx-background-color: transparent; -fx-box-border: transparent;"
           xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="org.example.SettingsController">
    <items>
        <AnchorPane maxWidth="350.0" minWidth="280.0"
                    style="-fx-background-color: transparent; -fx-border-color: transparent #e0e0e0 transparent transparent;">
            <children>
                <StackPane layoutX="23.0" layoutY="39.0" prefHeight="333.0" prefWidth="240.0"
                           style="-fx-background-color: transparent;" AnchorPane.bottomAnchor="227.0"
                           AnchorPane.leftAnchor="22.0" AnchorPane.rightAnchor="22.0" AnchorPane.topAnchor="38.0">
                    <children>
                        <VBox fx:id="profileView" alignment="CENTER" prefWidth="248.0" spacing="10.0"
                              style="-fx-background-color: rgba(255, 255, 255, 0.25); -fx-background-radius: 20; -fx-border-color: rgba(224, 224, 224, 0.5); -fx-border-radius: 20; -fx-padding: 20;"
                              visible="true">
                            <children>
                                <StackPane prefHeight="85.0" prefWidth="85.0">
                                    <children>
                                        <Circle fx:id="profileCircle" fill="#C7E1FF" radius="50.0" stroke="#ABD8FF"
                                                strokeType="INSIDE" strokeWidth="1.8"/>
                                        <Label fx:id="profileLetterLabel"
                                               style="-fx-font-size: 32px; -fx-text-fill: #0078fe; -fx-font-weight: bold;"
                                               text="U"/>
                                    </children>
                                </StackPane>
                                <Label fx:id="profileName"
                                       style="-fx-font-weight: bold; -fx-text-fill: #E3F0FC; -fx-font-size: 24px;"
                                       text="Username"/>
                                <Label fx:id="profileDate" style="-fx-text-fill: #E3F0FC; -fx-font-size: 16px;"
                                       text="Account Created"/>
                            </children>
                        </VBox>

                        <ScrollPane fx:id="myMeetupsListView" fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER"
                                    style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;"
                                    vbarPolicy="AS_NEEDED" visible="false">
                            <content>
                                <VBox fx:id="pastMeetups" spacing="18.0"
                                      style="-fx-background-color: rgba(255, 255, 255, 0.25); -fx-background-radius: 20; -fx-border-color: rgba(224, 224, 224, 0.5); -fx-border-radius: 20;">
                                    <padding>
                                        <Insets bottom="25.0" left="20.0" right="20.0" top="30.0"/>
                                    </padding>
                                    <children>
                                        <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;"
                                               text="Settings"/>
                                        <VBox fx:id="plannedMeetupsContainer" spacing="8.0"/>
                                        <VBox fx:id="pastMeetupsContainer" spacing="8.0"/>
                                    </children>
                                </VBox>
                            </content>
                        </ScrollPane>
                    </children>
                </StackPane>

                <VBox layoutX="16.0" layoutY="375.0" spacing="8.0"
                      style="-fx-border-color: #e0e0e0 transparent transparent transparent; -fx-padding: 15 0 0 0; -fx-background-color: transparent;"
                      AnchorPane.bottomAnchor="76.0" AnchorPane.leftAnchor="16.0" AnchorPane.rightAnchor="16.0">
                    <children>
                        <Button maxWidth="10000" mnemonicParsing="false" onAction="#handleAccountInfo"
                                prefHeight="38.0"
                                style="-fx-background-color: #0078fe; -fx-background-radius: 10; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"
                                text="Account Info">
                            <font>
                                <Font size="13.0"/>
                            </font>
                        </Button>
                        <Button maxWidth="10000" mnemonicParsing="false" onAction="#handleCustomization" prefHeight="38.0"
                                style="-fx-background-color: #f5f5f5; -fx-background-radius: 10; -fx-text-fill: #333333; -fx-font-weight: bold; -fx-cursor: hand;"
                                text="Customization"/>
                    </children>
                </VBox>

                <HBox alignment="CENTER" maxHeight="60.0" minHeight="60.0" prefHeight="60.0" spacing="12.0"
                      style="-fx-border-color: #e0e0e0 transparent transparent transparent; -fx-background-color: white;"
                      AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
                    <children>
                        <Button mnemonicParsing="false" onAction="#handleMain" prefHeight="35.0" prefWidth="35.0"
                                style="-fx-background-color: #f5f5f5; -fx-background-radius: 20; -fx-border-color: #cccccc; -fx-border-radius: 20; -fx-text-fill: black; -fx-font-weight: bold; -fx-cursor: hand;"
                                text="H"/>
                        <Button mnemonicParsing="false" onAction="#handleDiscovery" prefHeight="35.0" prefWidth="35.0"
                                style="-fx-background-color: #f5f5f5; -fx-background-radius: 20; -fx-border-color: #cccccc; -fx-border-radius: 20; -fx-text-fill: black; -fx-font-weight: bold; -fx-cursor: hand;"
                                text="D"/>
                        <Button mnemonicParsing="false" onAction="#handleChat" prefHeight="35.0" prefWidth="35.0"
                                style="-fx-background-color: #f5f5f5; -fx-background-radius: 20; -fx-border-color: #cccccc; -fx-border-radius: 20; -fx-text-fill: black; -fx-font-weight: bold; -fx-cursor: hand;"
                                text="C"/>
                        <Button mnemonicParsing="false" onAction="#handleLeaderboard" prefHeight="35.0" prefWidth="35.0"
                                style="-fx-background-color: #f5f5f5; -fx-background-radius: 20; -fx-border-color: #cccccc; -fx-border-radius: 20; -fx-text-fill: black; -fx-font-weight: bold; -fx-cursor: hand;"
                                text="L"/>
                        <Button mnemonicParsing="false" onAction="#handleSettings" prefHeight="35.0" prefWidth="35.0"
                                style="-fx-background-color: #0078fe; -fx-background-radius: 20; -fx-border-color: #0078fe; -fx-border-radius: 20; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"
                                text="S"/>
                    </children>
                </HBox>
            </children>
        </AnchorPane>

        <AnchorPane fx:id="contentArea" minHeight="0.0" minWidth="450.0" style="-fx-background-color: transparent;" />
    </items>
</SplitPane>
