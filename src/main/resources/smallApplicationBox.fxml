<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>

<HBox fx:id="smallApplicationBox" alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: #f5f5f5; -fx-background-radius: 15; -fx-padding: 12 20 12 20; -fx-border-color: #e8e8e8; -fx-border-radius: 15;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.SmallApplicationController">
   <children>
      <Circle fill="#e3f2fd" radius="24.0" stroke="#0078fe" strokeType="INSIDE" strokeWidth="1.5" />
      <VBox alignment="CENTER_LEFT">
         <children>
            <Label fx:id="smallApplicationUsername" style="-fx-font-weight: bold; -fx-text-fill: black;" text="Linda">
               <font>
                  <Font size="16.0" />
               </font>
            </Label>
            <Label fx:id="smallApplicationText" text="Wants to join: Football Match" textFill="#757575" />
         </children>
      </VBox>
      <Region HBox.hgrow="ALWAYS" />
      <HBox alignment="CENTER" spacing="5.0" style="-fx-background-color: #ffffff; -fx-background-radius: 20; -fx-border-color: #cccccc; -fx-border-radius: 20; -fx-padding: 2 10 2 10;">
         <children>
            <Button mnemonicParsing="false" onAction="#handleAcceptApplication" style="-fx-background-color: transparent; -fx-font-size: 18px; -fx-text-fill: #2e7d32; -fx-cursor: hand;" text="✔" />
            <Region prefHeight="25.0" prefWidth="1.0" style="-fx-background-color: #e0e0e0;" />
            <Button mnemonicParsing="false" onAction="#handleRejectApplication" style="-fx-background-color: transparent; -fx-font-size: 18px; -fx-text-fill: #c62828; -fx-cursor: hand;" text="✖" />
         </children>
      </HBox>
   </children>
</HBox>
