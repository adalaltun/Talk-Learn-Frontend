<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Priority?>

<HBox alignment="CENTER" fillHeight="true" maxWidth="Infinity" minHeight="60.0" prefHeight="60.0" spacing="12.0" style="-fx-border-color: #e0e0e0 transparent transparent transparent; -fx-background-color: white;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.NavigationController">
    <children>
        <Button fx:id="homeBtn" HBox.hgrow="ALWAYS" maxWidth="Infinity" prefHeight="35.0" style="-fx-background-color: #0078fe; -fx-background-radius:20; -fx-border-color:#0078fe; -fx-border-radius:20; -fx-text-fill:white; -fx-font-weight:bold; -fx-cursor:hand;" text="H" onAction="#handleMain" />
        <Button fx:id="discoveryBtn" HBox.hgrow="ALWAYS" maxWidth="Infinity" prefHeight="35.0" style="-fx-background-color:#f5f5f5; -fx-background-radius:20; -fx-border-color:#cccccc; -fx-border-radius:20; -fx-font-weight:bold; -fx-cursor:hand;" text="D" onAction="#handleDiscovery" />
        <Button fx:id="chatBtn" HBox.hgrow="ALWAYS" maxWidth="Infinity" prefHeight="35.0" style="-fx-background-color:#f5f5f5; -fx-background-radius:20; -fx-border-color:#cccccc; -fx-border-radius:20; -fx-font-weight:bold; -fx-cursor:hand;" text="C" onAction="#handleChat" />
        <Button fx:id="leaderboardBtn" HBox.hgrow="ALWAYS" maxWidth="Infinity" prefHeight="35.0" style="-fx-background-color:#f5f5f5; -fx-background-radius:20; -fx-border-color:#cccccc; -fx-border-radius:20; -fx-font-weight:bold; -fx-cursor:hand;" text="L" onAction="#handleLeaderboard" />
        <Button fx:id="settingsBtn" HBox.hgrow="ALWAYS" maxWidth="Infinity" prefHeight="35.0" style="-fx-background-color:#f5f5f5; -fx-background-radius:20; -fx-border-color:#cccccc; -fx-border-radius:20; -fx-text-fill:black; -fx-font-weight:bold; -fx-cursor:hand;" text="S" onAction="#handleSettings" />
    </children>
</HBox>