<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="400" prefWidth="600" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.LoginController">
   <children>
      <StackPane AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">
         <children>
            <VBox id="outerPane" alignment="CENTER" spacing="20" minWidth="320" minHeight="420" prefWidth="400" prefHeight="450" maxWidth="400" maxHeight="450">
               <children>

                  <StackPane fx:id="titlePane" minHeight="102" prefHeight="102" maxHeight="102" style="-fx-background-color: lightgray; -fx-border-radius: 12px; -fx-border-color: black;">
                     <children>
                        <Label alignment="CENTER" text="Talk&amp;Learn" StackPane.alignment="CENTER">
                           <font>
                              <Font size="40" />
                           </font>
                        </Label>
                     </children>
                  </StackPane>

                  <VBox fx:id="loginPane" alignment="CENTER" spacing="15" minHeight="240" prefHeight="270" maxHeight="270" style="-fx-background-color: lightgray; -fx-border-color: black; -fx-border-radius: 12px;">
                     <padding>
                        <Insets bottom="15" left="15" right="15" top="15" />
                     </padding>
                     <children>
                        <GridPane hgap="10" vgap="10" alignment="CENTER">
                           <columnConstraints>
                              <ColumnConstraints hgrow="NEVER" minWidth="70" prefWidth="80" />
                              <ColumnConstraints hgrow="ALWAYS" minWidth="120" prefWidth="160" />
                           </columnConstraints>
                           <rowConstraints>
                              <RowConstraints minHeight="40" prefHeight="45" vgrow="NEVER" />
                              <RowConstraints minHeight="40" prefHeight="45" vgrow="NEVER" />
                           </rowConstraints>
                           <children>
                              <Label text="Username:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                              <TextField alignment="CENTER" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                              <Label text="Password:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                              <PasswordField alignment="CENTER" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                           </children>
                        </GridPane>

                        <Button fx:id="loginButton" maxWidth="1000" mnemonicParsing="false" prefHeight="39" style="-fx-border-color: black; -fx-border-radius: 6px;" styleClass="f" text="Login" />

                        <HBox alignment="CENTER" spacing="10" maxWidth="1000">
                           <children>
                              <Label text="Create a new account:" />
                              <Button fx:id="signUpButton" mnemonicParsing="false" prefHeight="30" prefWidth="101" style="-fx-border-color: black; -fx-border-radius: 6px;" styleClass="f" text="Sign Up" />
                           </children>
                        </HBox>

                     </children>
                  </VBox>

               </children>
               <padding>
                  <Insets bottom="10" top="10" />
               </padding>
            </VBox>
         </children>
      </StackPane>
   </children>
</AnchorPane>