<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.DiscoveryController">
   <children>
      <SplitPane dividerPositions="0.25" focusTraversable="true" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="900.0" VBox.vgrow="ALWAYS">
         <items>
            <AnchorPane minHeight="-Infinity" minWidth="-Infinity" prefHeight="280.0" prefWidth="210.0" styleClass="sidebar">
               <children>
                  <Label text="Filters" AnchorPane.leftAnchor="10.0" AnchorPane.topAnchor="10.0">
                     <font>
                        <Font size="18.0" />
                     </font>
                  </Label>
                  <VBox prefHeight="200.0" prefWidth="100.0" spacing="5.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="40.0">
                     <children>
                        <RadioButton mnemonicParsing="false" text="Newest">
                           <font>
                              <Font size="14.0" />
                           </font>
                           <toggleGroup>
                              <ToggleGroup fx:id="filterButtons" />
                           </toggleGroup>
                        </RadioButton>
                        <RadioButton mnemonicParsing="false" text="Highest Rank" toggleGroup="$filterButtons">
                           <font>
                              <Font size="14.0" />
                           </font>
                        </RadioButton>
                        <RadioButton mnemonicParsing="false" text="Lowest Rank" toggleGroup="$filterButtons">
                           <font>
                              <Font size="14.0" />
                           </font>
                        </RadioButton>
                        <RadioButton mnemonicParsing="false" text="Group" toggleGroup="$filterButtons">
                           <font>
                              <Font size="14.0" />
                           </font>
                        </RadioButton>
                     </children>
                  </VBox>
                  <Label layoutX="10.0" layoutY="10.0" text="Tags" AnchorPane.leftAnchor="10.0" AnchorPane.topAnchor="230.0">
                     <font>
                        <Font size="18.0" />
                     </font>
                  </Label>
                  <VBox layoutX="10.0" layoutY="10.0" prefHeight="100.0" prefWidth="201.0" spacing="5.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="260.0">
                     <children>
                        <RadioButton mnemonicParsing="false" text="Game Night">
                           <font>
                              <Font size="14.0" />
                           </font>
                           <toggleGroup>
                              <ToggleGroup fx:id="tagButtons" />
                           </toggleGroup>
                        </RadioButton>
                        <RadioButton mnemonicParsing="false" text="Cooking" toggleGroup="$tagButtons">
                           <font>
                              <Font size="14.0" />
                           </font>
                        </RadioButton>
                        <RadioButton mnemonicParsing="false" text="Sports" toggleGroup="$tagButtons">
                           <font>
                              <Font size="14.0" />
                           </font>
                        </RadioButton>
                        <RadioButton mnemonicParsing="false" text="Bilkent" toggleGroup="$tagButtons">
                           <font>
                              <Font size="14.0" />
                           </font>
                        </RadioButton>
                     </children>
                  </VBox>
                  <Button mnemonicParsing="false" onAction="#handleDebugAddListing" prefHeight="32.0" prefWidth="210.0" text="Add Listing (DEBUG)" AnchorPane.bottomAnchor="80.0" AnchorPane.leftAnchor="5.0" AnchorPane.rightAnchor="5.0" />
                  <Button layoutX="3.0" layoutY="534.0" maxHeight="-Infinity" maxWidth="170.0" minHeight="-Infinity" minWidth="-Infinity" mnemonicParsing="false" prefHeight="32.0" prefWidth="210.0" text="Search" AnchorPane.bottomAnchor="45.0" AnchorPane.leftAnchor="5.0" AnchorPane.rightAnchor="5.0" />
                  <HBox layoutY="572.0" maxHeight="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="32.0" prefWidth="170.0" spacing="5.0" styleClass="bottom-bar" AnchorPane.bottomAnchor="5.0" AnchorPane.leftAnchor="5.0" AnchorPane.rightAnchor="5.0">
                     <children>
                        <Button alignment="CENTER" mnemonicParsing="false" onAction="#handleMain" prefHeight="32.0" prefWidth="42.0" styleClass="nav-button" text="H" HBox.hgrow="ALWAYS" />
                        <Button alignment="CENTER" mnemonicParsing="false" onAction="#handleDiscovery" prefHeight="32.0" prefWidth="42.0" styleClass="nav-button" text="D" HBox.hgrow="ALWAYS" />
                        <Button alignment="CENTER" mnemonicParsing="false" onAction="#handleChat" prefHeight="32.0" prefWidth="42.0" styleClass="nav-button" text="C" HBox.hgrow="ALWAYS" />
                        <Button alignment="CENTER" mnemonicParsing="false" onAction="#handleLeaderboard" prefHeight="32.0" prefWidth="42.0" styleClass="nav-button" text="R" HBox.hgrow="ALWAYS" />
                        <Button alignment="CENTER" mnemonicParsing="false" onAction="#handleSettings" prefHeight="32.0" prefWidth="42.0" styleClass="nav-button" text="S" HBox.hgrow="ALWAYS" />
                     </children>
                  </HBox>
                  <Button layoutX="5.0" layoutY="447.0" mnemonicParsing="false" onAction="#handleReadAllListings" prefHeight="32.0" prefWidth="210.0" text="Read All From DB (DEBUG)" />
               </children>
            </AnchorPane>
            <ScrollPane hbarPolicy="NEVER" vbarPolicy="ALWAYS">
               <content>
                  <AnchorPane id="Content" minHeight="-1.0" minWidth="-1.0" styleClass="content-area">
                     <children>
                        <Label alignment="CENTER" layoutX="14.0" layoutY="14.0" style="&#10;" text="Listings" textAlignment="CENTER" wrapText="false">
                           <font>
                              <Font size="18.0" fx:id="x1" />
                           </font>
                           <textFill>
                              <Color red="0.624" green="0.624" blue="0.624" fx:id="x2" />
                           </textFill>
                        </Label>
                        <VBox fx:id="listingBox" layoutX="5.0" layoutY="43.0" prefHeight="550.0" prefWidth="655.0">
                           <children>

                           <!-- fx:include denemesi işe yaradı -->
                              <fx:include fx:id="discoveryListing" source="discoveryListing.fxml" />
                              <fx:include fx:id="discoveryListing1" source="discoveryListing.fxml" />
                           </children>
                        </VBox>
                     </children>
                  </AnchorPane>
               </content>
            </ScrollPane>
         </items>
      </SplitPane>
   </children>
</VBox>
