<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.ChatController">
    <children>
        <SplitPane dividerPositions="0.3" focusTraversable="true" VBox.vgrow="ALWAYS">
            <items>
                <BorderPane maxWidth="350.0" minWidth="250.0">
                    <center>
                        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent;" BorderPane.alignment="CENTER">
                            <content>
                                <VBox spacing="10.0">
                                    <padding>
                                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                                    </padding>

                                    <HBox alignment="CENTER_LEFT" prefHeight="60.0" spacing="15.0" style="-fx-border-color: black; -fx-border-radius: 10; -fx-background-radius: 10; -fx-background-color: #e5e5e5;">
                                        <padding><Insets left="15.0" /></padding>
                                        <Circle fill="BLACK" radius="20.0" />
                                        <Label text="name">
                                            <font><Font size="14.0" /></font>
                                        </Label>
                                    </HBox>

                                    <HBox alignment="CENTER_LEFT" prefHeight="60.0" spacing="15.0" style="-fx-border-color: black; -fx-border-radius: 10; -fx-background-radius: 10; -fx-background-color: #e5e5e5;">
                                        <padding><Insets left="15.0" /></padding>
                                        <Circle fill="#ffc2d1" radius="20.0" stroke="BLACK" strokeType="INSIDE" />
                                        <Label text="Mehmet">
                                            <font><Font size="14.0" /></font>
                                        </Label>
                                    </HBox>

                                    <HBox alignment="CENTER_LEFT" prefHeight="60.0" spacing="15.0" style="-fx-border-color: black; -fx-border-radius: 10; -fx-background-radius: 10; -fx-background-color: #a6a6a6;">
                                        <padding><Insets left="15.0" /></padding>
                                        <Circle fill="#d1c4e9" radius="20.0" stroke="BLACK" strokeType="INSIDE" />
                                        <Label text="Linda">
                                            <font><Font size="14.0" /></font>
                     W                   </Label>
                                    </HBox>

                                    <HBox alignment="CENTER_LEFT" prefHeight="60.0" spacing="15.0" style="-fx-border-color: black; -fx-border-radius: 10; -fx-background-radius: 10; -fx-background-color: #e5e5e5;">
                                        <padding><Insets left="15.0" /></padding>
                                        <Circle fill="#b2ebf2" radius="20.0" stroke="BLACK" strokeType="INSIDE" />
                                        <Label text="Group Meeting">
                                            <font><Font size="14.0" /></font>
                                        </Label>
                                    </HBox>
                                </VBox>
                            </content>
                        </ScrollPane>
                    </center>

                    <bottom>
                        <HBox alignment="CENTER" prefHeight="60.0" spacing="15.0" style="-fx-border-color: black transparent transparent transparent;" BorderPane.alignment="CENTER">
                            <Button mnemonicParsing="false" prefHeight="35.0" prefWidth="35.0" style="-fx-background-radius: 20; -fx-border-color: black; -fx-border-radius: 20;" text="H" />
                            <Button mnemonicParsing="false" prefHeight="35.0" prefWidth="35.0" style="-fx-background-radius: 20; -fx-border-color: black; -fx-border-radius: 20;" text="+" />
                            <Button mnemonicParsing="false" prefHeight="35.0" prefWidth="35.0" style="-fx-background-radius: 20; -fx-border-color: black; -fx-border-radius: 20;" text="C" />
                            <Button mnemonicParsing="false" prefHeight="35.0" prefWidth="35.0" style="-fx-background-radius: 20; -fx-border-color: black; -fx-border-radius: 20;" text="B" />
                            <Button mnemonicParsing="false" prefHeight="35.0" prefWidth="35.0" style="-fx-background-radius: 20; -fx-border-color: black; -fx-border-radius: 20;" text="S" />
                        </HBox>
                    </bottom>
                </BorderPane>

                <BorderPane>
                    <top>
                        <HBox alignment="CENTER_LEFT" prefHeight="70.0" spacing="15.0" style="-fx-background-color: #a6a6a6; -fx-background-radius: 15;" BorderPane.alignment="CENTER">
                            <BorderPane.margin>
                                <Insets left="10.0" right="10.0" top="10.0" />
                            </BorderPane.margin>
                            <padding>
                                <Insets left="20.0" right="20.0" />
                            </padding>
                            <Circle fill="#d1c4e9" radius="25.0" stroke="#8a2be2" strokeType="INSIDE" strokeWidth="2.0" />
                            <Label text="Linda" textFill="BLACK">
                                <font><Font size="18.0" /></font>
                            </Label>

                            <Region HBox.hgrow="ALWAYS" />

                            <Button fx:id="withdrawButton" mnemonicParsing="false" prefHeight="35.0" prefWidth="120.0" style="-fx-background-color: #e0e0e0; -fx-background-radius: 20;" text="Withdraw">
                                <font><Font size="14.0" /></font>
                            </Button>
                        </HBox>
                    </top>

                    <center>
                        <VBox alignment="TOP_CENTER" prefHeight="200.0" prefWidth="100.0" BorderPane.alignment="CENTER">
                            <padding><Insets top="30.0" /></padding>
                            <Label alignment="CENTER" prefWidth="450.0" style="-fx-background-color: #cccccc; -fx-background-radius: 10; -fx-border-color: black; -fx-border-radius: 10;" text="Start the conversation and get to know each other.&#10;Meeting topic: Football" textAlignment="CENTER" textFill="#4d4d4d">
                                <padding><Insets bottom="15.0" left="20.0" right="20.0" top="15.0" /></padding>
                                <font><Font name="System Italic" size="14.0" /></font>
                            </Label>
                        </VBox>
                    </center>

                    <bottom>
                        <HBox alignment="CENTER" prefHeight="80.0" spacing="10.0" BorderPane.alignment="CENTER">
                            <padding><Insets bottom="20.0" left="20.0" right="20.0" top="10.0" /></padding>

                            <HBox alignment="CENTER_LEFT" style="-fx-background-color: #a6a6a6; -fx-background-radius: 30; -fx-border-color: black; -fx-border-radius: 30;" HBox.hgrow="ALWAYS">
                                <padding><Insets bottom="5.0" left="20.0" right="10.0" top="5.0" /></padding>

                                <TextField fx:id="messageField" promptText="Send a message..." style="-fx-background-color: transparent;" HBox.hgrow="ALWAYS">
                                    <font><Font name="System Italic" size="14.0" /></font>
                                </TextField>

                                <Button fx:id="sendButton" mnemonicParsing="false" prefHeight="35.0" prefWidth="40.0" style="-fx-background-color: #e0e0e0; -fx-background-radius: 20; -fx-border-color: black; -fx-border-radius: 20;" text="➤" />
                            </HBox>
                        </HBox>
                    </bottom>
                </BorderPane>
            </items>
        </SplitPane>
    </children>
</VBox>
