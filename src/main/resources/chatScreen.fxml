<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>

<SplitPane fx:id="rootPane" dividerPositions="0.32" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: white; -fx-box-border: transparent;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.ChatController">
    <items>
        <AnchorPane maxWidth="350.0" minWidth="280.0" style="-fx-background-color: white; -fx-border-color: transparent #e0e0e0 transparent transparent;">
            <children>
                <VBox alignment="CENTER" prefHeight="60.0" style="-fx-background-color: white; -fx-border-color: transparent transparent #e0e0e0 transparent;" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                    <padding>
                        <Insets left="15.0" right="15.0" />
                    </padding>
                    <children>
                        <Button fx:id="addPeopleButton" maxWidth="10000" mnemonicParsing="false" onAction="#handleAddPeople" prefHeight="38.0" style="-fx-background-color: #0078fe; -fx-background-radius: 10; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="+ Add People">
                            <font>
                                <Font size="13.0" />
                            </font>
                        </Button>
                    </children>
                </VBox>

                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: white; -fx-background: white; -fx-border-color: transparent;" AnchorPane.bottomAnchor="60.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="60.0">
                    <content>
                        <VBox fx:id="chatListContainer" spacing="20.0" style="-fx-background-color: white;">
                            <padding>
                                <Insets bottom="25.0" left="20.0" right="20.0" top="30.0" />
                            </padding>
                        </VBox>
                    </content>
                </ScrollPane>

                <HBox alignment="CENTER" maxHeight="60.0" minHeight="60.0" prefHeight="60.0" spacing="12.0" style="-fx-border-color: #e0e0e0 transparent transparent transparent; -fx-background-color: white;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
                    <children>
                        <Button mnemonicParsing="false" onAction="#handleGoHome" prefHeight="35.0" prefWidth="35.0" style="-fx-background-color: #f5f5f5; -fx-background-radius: 20; -fx-border-color: #cccccc; -fx-border-radius: 20; -fx-text-fill: black; -fx-font-weight: bold; -fx-cursor: hand;" text="H" />
                        <Button mnemonicParsing="false" onAction="#handleGoDiscovery" prefHeight="35.0" prefWidth="35.0" style="-fx-background-color: #f5f5f5; -fx-background-radius: 20; -fx-border-color: #cccccc; -fx-border-radius: 20; -fx-text-fill: black; -fx-font-weight: bold; -fx-cursor: hand;" text="D" />
                        <Button mnemonicParsing="false" prefHeight="35.0" prefWidth="35.0" style="-fx-background-color: #0078fe; -fx-background-radius: 20; -fx-border-color: #0078fe; -fx-border-radius: 20; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="C" />
                        <Button mnemonicParsing="false" onAction="#handleGoLeaderboard" prefHeight="35.0" prefWidth="35.0" style="-fx-background-color: #f5f5f5; -fx-background-radius: 20; -fx-border-color: #cccccc; -fx-border-radius: 20; -fx-text-fill: black; -fx-font-weight: bold; -fx-cursor: hand;" text="L" />
                        <Button mnemonicParsing="false" prefHeight="35.0" prefWidth="35.0" style="-fx-background-color: #f5f5f5; -fx-background-radius: 20; -fx-border-color: #cccccc; -fx-border-radius: 20; -fx-text-fill: black; -fx-font-weight: bold; -fx-cursor: hand;" text="S" />
                    </children>
                </HBox>
            </children>
        </AnchorPane>

        <AnchorPane minHeight="0.0" minWidth="450.0" style="-fx-background-color: white;">
            <children>
                <HBox fx:id="chatHeaderBar" alignment="CENTER_LEFT" prefHeight="70.0" spacing="15.0" style="-fx-background-color: #f5f5f5; -fx-background-radius: 15; -fx-border-color: #e0e0e0; -fx-border-radius: 15;" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0">
                    <padding>
                        <Insets left="20.0" right="20.0" />
                    </padding>
                    <children>
                        <Circle fill="#d1c4e9" radius="25.0" stroke="#8a2be2" strokeType="INSIDE" strokeWidth="2.0" />
                        <Label fx:id="activeChatTitle" text="Sohbet" textFill="BLACK">
                            <font>
                                <Font size="18.0" />
                            </font>
                        </Label>
                        <Region HBox.hgrow="ALWAYS" />
                        <Button onAction="#handleBackToWelcome" style="-fx-cursor: hand; -fx-background-color: #e3f2fd; -fx-text-fill: #0078fe; -fx-font-weight: bold; -fx-background-radius: 5;" text="← Return" />
                        <Button fx:id="withdrawButton" mnemonicParsing="false" onAction="#handleWithdraw" prefHeight="35.0" prefWidth="120.0" style="-fx-background-color: #e0e0e0; -fx-background-radius: 20; -fx-text-fill: black;" text="Withdraw">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Button>
                    </children>
                </HBox>

                <StackPane style="-fx-background-color: white;" AnchorPane.bottomAnchor="80.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="90.0">
                    <children>
                        <VBox fx:id="welcomePanel" alignment="CENTER" spacing="20.0" style="-fx-background-color: #ffffff;">
                            <padding>
                                <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
                            </padding>
                            <children>
                                <Circle fill="#e3f2fd" radius="50.0" stroke="#90caf9" strokeType="INSIDE" strokeWidth="2.0" />
                                <Label text="Welcome to Talk &amp; Learn!" textFill="#1a1a1a">
                                    <font>
                                        <Font name="System Bold" size="24.0" />
                                    </font>
                                </Label>
                                <Label alignment="CENTER" prefWidth="420.0" text="Please select a contact from the left panel to start chatting and learning.&#10;&#10;⚠️ Keep your conversations constructive and always be respectful while chatting." textAlignment="CENTER" textFill="#757575" wrapText="true">
                                    <font>
                                        <Font name="System Italic" size="14.0" />
                                    </font>
                                </Label>
                            </children>
                        </VBox>
                        <ScrollPane fx:id="chatScrollArea" fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: white; -fx-background: white; -fx-border-color: transparent;" vbarPolicy="AS_NEEDED">
                            <content>
                                <VBox fx:id="chatMessageArea" spacing="10.0" style="-fx-background-color: white;">
                                    <padding>
                                        <Insets bottom="10.0" left="15.0" right="15.0" top="10.0" />
                                    </padding>
                                    <children>
                                        <VBox alignment="TOP_CENTER" style="-fx-background-color: white;">
                                            <padding>
                                                <Insets bottom="20.0" top="10.0" />
                                            </padding>
                                            <Label alignment="CENTER" prefWidth="450.0" style="-fx-background-color: #f0f0f0; -fx-background-radius: 10; -fx-border-color: #cccccc; -fx-border-radius: 10;" text="Start the conversation and get to know each other.&#10;Meeting topic: Football" textAlignment="CENTER" textFill="#4d4d4d">
                                                <padding>
                                                    <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
                                                </padding>
                                                <font>
                                                    <Font name="System Italic" size="14.0" />
                                                </font>
                                            </Label>
                                        </VBox>
                                    </children>
                                </VBox>
                            </content>
                        </ScrollPane>
                    </children>
                </StackPane>

                <HBox fx:id="chatInputBar" alignment="CENTER" prefHeight="80.0" spacing="10.0" style="-fx-background-color: white;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
                    <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="10.0" />
                    </padding>
                    <children>
                        <HBox alignment="CENTER_LEFT" style="-fx-background-color: #f5f5f5; -fx-background-radius: 30; -fx-border-color: #cccccc; -fx-border-radius: 30;" HBox.hgrow="ALWAYS">
                            <padding>
                                <Insets bottom="5.0" left="20.0" right="10.0" top="5.0" />
                            </padding>
                            <children>
                                <TextField fx:id="messageField" onAction="#sendMessage" onKeyPressed="#handleChatKeyEvents" promptText="Send a message..." style="-fx-background-color: transparent; -fx-text-fill: black; -fx-prompt-text-fill: #888888;" HBox.hgrow="ALWAYS">
                                    <font>
                                        <Font name="System Italic" size="14.0" />
                                    </font>
                                </TextField>
                                <Button fx:id="sendButton" mnemonicParsing="false" onAction="#sendMessage" prefHeight="35.0" prefWidth="40.0" style="-fx-background-color: #0078fe; -fx-background-radius: 20; -fx-text-fill: white;" text="➤" />
                            </children>
                        </HBox>
                    </children>
                </HBox>
            </children>
        </AnchorPane>
    </items>
</SplitPane>