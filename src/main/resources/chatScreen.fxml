<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>

<VBox onKeyPressed="#handleChatKeyEvents" prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.ChatController">
    <children>
        <SplitPane dividerPositions="0.28" focusTraversable="true" style="-fx-background-color: white; -fx-box-border: transparent;" VBox.vgrow="ALWAYS">
            <items>
                <!-- FIXED CHAT SIDEBAR: Set to match 240px bounds perfectly -->
                <BorderPane maxWidth="240.0" minWidth="240.0" style="-fx-background-color: white; -fx-border-color: transparent #e0e0e0 transparent transparent;">
                    <top>
                        <VBox alignment="CENTER" prefHeight="60.0" style="-fx-background-color: white; -fx-border-color: transparent transparent #e0e0e0 transparent;" BorderPane.alignment="CENTER">
                            <padding>
                                <Insets left="15.0" right="15.0" />
                            </padding>
                            <children>
                                <Button fx:id="addPeopleButton" mnemonicParsing="false" onAction="#handleAddPeople" prefHeight="38.0" prefWidth="210.0" style="-fx-background-color: #0078fe; -fx-background-radius: 10; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="+ Add People">
                                    <font>
                                        <Font size="13.0" />
                                    </font>
                                </Button>
                            </children>
                        </VBox>
                    </top>

                    <center>
                        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: white; -fx-background: white; -fx-border-color: transparent;" BorderPane.alignment="CENTER">
                            <content>
                                <VBox fx:id="chatListContainer" spacing="10.0" style="-fx-background-color: white;">
                                    <padding>
                                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                                    </padding>
                                </VBox>
                            </content>
                        </ScrollPane>
                    </center>

                    <!-- Navigation Bar Include -->
                    <bottom>
                        <fx:include fx:id="navMenu" source="navigationMenu.fxml" />
                    </bottom>
                </BorderPane>

                <BorderPane style="-fx-background-color: white;">
                    <top>
                        <HBox fx:id="chatHeaderBar" alignment="CENTER_LEFT" prefHeight="70.0" spacing="15.0" style="-fx-background-color: #f5f5f5; -fx-background-radius: 15; -fx-border-color: #e0e0e0; -fx-border-radius: 15;" BorderPane.alignment="CENTER">
                            <BorderPane.margin>
                                <Insets left="10.0" right="10.0" top="10.0" />
                            </BorderPane.margin>
                            <padding>
                                <Insets left="20.0" right="20.0" />
                            </padding>
                            <Circle fill="#d1c4e9" radius="25.0" stroke="#8a2be2" strokeType="INSIDE" strokeWidth="2.0" />
                            <Label fx:id="activeChatTitle" text="Sohbet" textFill="BLACK">
                                <font><Font size="18.0" /></font>
                            </Label>
                            <Region HBox.hgrow="ALWAYS" />
                            <Button onAction="#handleBackToWelcome" style="-fx-cursor: hand; -fx-background-color: #e3f2fd; -fx-text-fill: #0078fe; -fx-font-weight: bold; -fx-background-radius: 5;" text="← Return" />
                            <Button fx:id="withdrawButton" mnemonicParsing="false" onAction="#handleWithdraw" prefHeight="35.0" prefWidth="120.0" style="-fx-background-color: #e0e0e0; -fx-background-radius: 20; -fx-text-fill: black;" text="Withdraw">
                                <font><Font size="14.0" /></font>
                            </Button>
                        </HBox>
                    </top>
                    <center>
                        <StackPane style="-fx-background-color: white;" BorderPane.alignment="CENTER">
                            <children>
                                <VBox fx:id="welcomePanel" alignment="CENTER" spacing="20.0" style="-fx-background-color: #ffffff;">
                                    <padding><Insets bottom="40.0" left="40.0" right="40.0" top="40.0" /></padding>
                                    <children>
                                        <Circle fill="#e3f2fd" radius="50.0" stroke="#90caf9" strokeType="INSIDE" strokeWidth="2.0" />
                                        <ScrollPane fx:id="chatScrollArea" fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: white; -fx-background: white; -fx-border-color: transparent;" vbarPolicy="AS_NEEDED">
                                            <content>
                                                <VBox fx:id="chatMessageArea" spacing="10.0" style="-fx-background-color: white;">
                                                    <padding>
                                                        <Insets bottom="10.0" left="15.0" right="15.0" top="10.0" />
                                                    </padding>
                                                    <children>
                                                        <VBox alignment="TOP_CENTER" style="-fx-background-color: white;">
                                                            <padding>
                                                                <Insets bottom="20.0" top="10.0" />
                                                            </padding>
                                                            <Label alignment="CENTER" prefWidth="450.0" style="-fx-background-color: #f0f0f0; -fx-background-radius: 10; -fx-border-color: #cccccc; -fx-border-radius: 10;" text="Start the conversation and get to know each other.&#10;Meeting topic: Football" textAlignment="CENTER" textFill="#4d4d4d">
                                                                <padding>
                                                                    <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
                                                                </padding>
                                                                <font>
                                                                    <Font name="System Italic" size="14.0" />
                                                                </font>
                                                            </Label>
                                                        </VBox>
                                                    </children>
                                                </VBox>
                                            </content>
                                        </ScrollPane>
                                        <Label text="Welcome to Talk &amp; Learn!" textFill="#1a1a1a">
                                            <font><Font name="System Bold" size="24.0" /></font>
                                        </Label>
                                        <Label alignment="CENTER" prefWidth="420.0" text="Please select a contact from the left panel to start chatting and learning.&#10;&#10;⚠️ Keep your conversations constructive and always be respectful while chatting." textAlignment="CENTER" textFill="#757575" wrapText="true">
                                            <font><Font name="System Italic" size="14.0" /></font>
                                        </Label>
                                    </children>
                                </VBox>
                            </children>
                        </StackPane>
                    </center>
                    <bottom>
                        <HBox fx:id="chatInputBar" alignment="CENTER" prefHeight="80.0" spacing="10.0" style="-fx-background-color: white;" BorderPane.alignment="CENTER">
                            <padding><Insets bottom="20.0" left="20.0" right="20.0" top="10.0" /></padding>
                            <HBox alignment="CENTER_LEFT" style="-fx-background-color: #f5f5f5; -fx-background-radius: 30; -fx-border-color: #cccccc; -fx-border-radius: 30;" HBox.hgrow="ALWAYS">
                                <padding><Insets bottom="5.0" left="20.0" right="10.0" top="5.0" /></padding>
                                <TextField fx:id="messageField" onAction="#sendMessage" onKeyPressed="#handleChatKeyEvents" promptText="Send a message..." style="-fx-background-color: transparent; -fx-text-fill: black; -fx-prompt-text-fill: #888888;" HBox.hgrow="ALWAYS">
                                    <font><Font name="System Italic" size="14.0" /></font>
                                </TextField>
                                <Button fx:id="sendButton" mnemonicParsing="false" onAction="#sendMessage" prefHeight="35.0" prefWidth="40.0" style="-fx-background-color: #0078fe; -fx-background-radius: 20; -fx-text-fill: white;" text="➤" />
                            </HBox>
                        </HBox>
                    </bottom>
                </BorderPane>
            </items>
        </SplitPane>
    </children>
</VBox>