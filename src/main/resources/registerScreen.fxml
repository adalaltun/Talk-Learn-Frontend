<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="400" prefWidth="600" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.RegisterController">
    <children>
        <StackPane AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">
            <children>
                <VBox fx:id="outerPane" alignment="CENTER" maxHeight="500" maxWidth="400" minHeight="470" minWidth="320" prefHeight="500" prefWidth="400" spacing="20">
                    <children>
                        <StackPane fx:id="titlePane" maxHeight="102" minHeight="102" prefHeight="102" style="-fx-background-color: lightgray; -fx-border-radius: 12px; -fx-border-color: black;">
                            <children>
                                <Label alignment="CENTER" text="Talk&amp;Learn" StackPane.alignment="CENTER">
                                    <font>
                                        <Font size="40" />
                                    </font>
                                </Label>
                            </children>
                        </StackPane>

                        <VBox fx:id="loginPane" alignment="CENTER" maxHeight="320" minHeight="290" prefHeight="320" spacing="15" style="-fx-background-color: lightgray; -fx-border-color: black; -fx-border-radius: 12px;">
                            <padding>
                                <Insets bottom="15" left="15" right="15" top="15" />
                            </padding>
                            <children>
                                <GridPane alignment="CENTER" hgap="10" vgap="10">
                                    <columnConstraints>
                                        <ColumnConstraints hgrow="NEVER" minWidth="100" prefWidth="110" />
                                        <ColumnConstraints hgrow="ALWAYS" minWidth="120" prefWidth="160" />
                                    </columnConstraints>
                                    <rowConstraints>
                                        <RowConstraints minHeight="40" prefHeight="45" vgrow="NEVER" />
                                        <RowConstraints minHeight="40" prefHeight="45" vgrow="NEVER" />
                                        <RowConstraints minHeight="40" prefHeight="45" vgrow="NEVER" />
                                    </rowConstraints>
                                    <children>
                                        <Label text="Username:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                        <TextField fx:id="usernameField" onKeyPressed="#handleRegisterKeyEvents" alignment="CENTER" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                                        <Label text="Password:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                                        <PasswordField fx:id="passwordField" onKeyPressed="#handleRegisterKeyEvents" alignment="CENTER" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                                        <Label text="Confirm Password:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                                        <PasswordField fx:id="repeatedPasswordField" onKeyPressed="#handleRegisterKeyEvents" alignment="CENTER" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                                    </children>
                                </GridPane>

                                <Button fx:id="signUpButton" maxWidth="1000" mnemonicParsing="false" onAction="#handleRegister" prefHeight="39" style="-fx-border-color: black; -fx-border-radius: 6px;" styleClass="f" text="Sign Up" />

                                <HBox alignment="CENTER" maxWidth="1000" spacing="10">
                                    <children>
                                        <Label text="Already have an account:" />
                                        <Button fx:id="loginButton" onAction="#switchScene" mnemonicParsing="false" prefHeight="30" prefWidth="101" style="-fx-border-color: black; -fx-border-radius: 6px;" styleClass="f" text="Login" />
                                    </children>
                                </HBox>

                            </children>
                        </VBox>

                    </children>
                    <padding>
                        <Insets bottom="10" top="10" />
                    </padding>
                </VBox>
            </children>
        </StackPane>
    </children>
</AnchorPane>
