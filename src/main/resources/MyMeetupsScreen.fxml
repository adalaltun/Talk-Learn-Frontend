<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>

<AnchorPane minHeight="0.0" minWidth="450.0" prefHeight="600.0" prefWidth="650.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.HomeController">
    <children>

        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" style="-fx-background-color: white; -fx-background: white; -fx-border-color: transparent;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <content>
                <VBox fx:id="applicationsContainer" spacing="18.0" style="-fx-padding: 25.0; -fx-background-color: white;">
                    <children>

                        <Label text="Incoming Applications" textFill="#1a1a1a">
                            <font>
                                <Font name="System Bold" size="22.0" />
                            </font>
                        </Label>

                        <!-- Profile Application Row 1 -->
                        <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: #f5f5f5; -fx-background-radius: 15; -fx-padding: 12 20 12 20; -fx-border-color: #e8e8e8; -fx-border-radius: 15;">
                            <children>
                                <Circle fill="#e3f2fd" radius="24.0" stroke="#0078fe" strokeType="INSIDE" strokeWidth="1.5" />
                                <VBox alignment="CENTER_LEFT">
                                    <children>
                                        <Label style="-fx-font-weight: bold; -fx-text-fill: black;" text="Linda">
                                            <font>
                                                <Font size="16.0" />
                                            </font></Label>
                                        <Label text="Wants to join: Football Match" textFill="#757575" />
                                    </children>
                                </VBox>
                                <Region HBox.hgrow="ALWAYS" />
                                <HBox alignment="CENTER" spacing="5.0" style="-fx-background-color: #ffffff; -fx-background-radius: 20; -fx-border-color: #cccccc; -fx-border-radius: 20; -fx-padding: 2 10 2 10;">
                                    <children>
                                        <Button mnemonicParsing="false" onAction="#handleAcceptApplication" style="-fx-background-color: transparent; -fx-font-size: 18px; -fx-text-fill: #2e7d32; -fx-cursor: hand;" text="✔" />
                                        <Region prefWidth="1.0" prefHeight="25.0" style="-fx-background-color: #e0e0e0;" />
                                        <Button mnemonicParsing="false" onAction="#handleRejectApplication" style="-fx-background-color: transparent; -fx-font-size: 18px; -fx-text-fill: #c62828; -fx-cursor: hand;" text="✖" />
                                    </children>
                                </HBox>
                            </children>
                        </HBox>

                        <!-- Profile Application Row 2 -->
                        <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: #f5f5f5; -fx-background-radius: 15; -fx-padding: 12 20 12 20; -fx-border-color: #e8e8e8; -fx-border-radius: 15;">
                            <children>
                                <Circle fill="#e3f2fd" radius="24.0" stroke="#0078fe" strokeType="INSIDE" strokeWidth="1.5" />
                                <VBox alignment="CENTER_LEFT">
                                    <children>
                                        <Label style="-fx-font-weight: bold; -fx-text-fill: black;" text="James">
                                            <font>
                                                <Font size="16.0" />
                                            </font></Label>
                                        <Label text="Wants to join: Pizza Night" textFill="#757575" />
                                    </children>
                                </VBox>
                                <Region HBox.hgrow="ALWAYS" />
                                <HBox alignment="CENTER" spacing="5.0" style="-fx-background-color: #ffffff; -fx-background-radius: 20; -fx-border-color: #cccccc; -fx-border-radius: 20; -fx-padding: 2 10 2 10;">
                                    <children>
                                        <Button mnemonicParsing="false" onAction="#handleAcceptApplication" style="-fx-background-color: transparent; -fx-font-size: 18px; -fx-text-fill: #2e7d32; -fx-cursor: hand;" text="✔" />
                                        <Region prefWidth="1.0" prefHeight="25.0" style="-fx-background-color: #e0e0e0;" />
                                        <Button mnemonicParsing="false" onAction="#handleRejectApplication" style="-fx-background-color: transparent; -fx-font-size: 18px; -fx-text-fill: #c62828; -fx-cursor: hand;" text="✖" />
                                    </children>
                                </HBox>
                            </children>
                        </HBox>

                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </children>
</AnchorPane>