<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>

<AnchorPane minHeight="0.0" minWidth="450.0" prefHeight="600.0" prefWidth="650.0" style="-fx-background-color: transparent;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.SettingsController">
    <children>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;" vbarPolicy="AS_NEEDED" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <content>
                <VBox spacing="25.0" style="-fx-padding: 30.0; -fx-background-color: transparent;">
                    <children>

                        <Label text="Customization" textFill="black">
                            <font>
                                <Font name="System Bold" size="26.0" />
                            </font>
                        </Label>

                        <VBox spacing="15.0" style="-fx-background-color: rgba(255, 255, 255, 0.25); -fx-background-radius: 20; -fx-border-color: rgba(224, 224, 224, 0.5); -fx-border-radius: 20; -fx-padding: 20.0;">
                            <children>
                                <Label text="Choose Profile Picture" textFill="black">
                                    <font>
                                        <Font name="System Bold" size="16.0" />
                                    </font>
                                </Label>

                                <HBox alignment="CENTER_LEFT" spacing="15.0">
                                    <children>
                                        <Button fx:id="avatar1" mnemonicParsing="false" onAction="#handleAvatarSelection" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-padding: 0;">
                                            <graphic>
                                                <Circle fx:id="avatarOpt1" fill="#e3f2fd" opacity="0.0" radius="35.0" stroke="#0078fe" strokeType="INSIDE" strokeWidth="2.0" />
                                            </graphic>
                                        </Button>

                                        <Button mnemonicParsing="false" onAction="#handleAvatarSelection" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-padding: 0;">
                                            <graphic>
                                                <Circle fx:id="avatarOpt2" fill="#e3f2fd" radius="35.0" stroke="transparent" strokeType="INSIDE" strokeWidth="2.0" />
                                            </graphic>
                                        </Button>

                                        <Button mnemonicParsing="false" onAction="#handleAvatarSelection" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-padding: 0;">
                                            <graphic>
                                                <Circle fx:id="avatarOpt3" fill="#e3f2fd" radius="35.0" stroke="transparent" strokeType="INSIDE" strokeWidth="2.0" />
                                            </graphic>
                                        </Button>

                                        <Button mnemonicParsing="false" onAction="#handleAvatarSelection" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-padding: 0;">
                                            <graphic>
                                                <Circle fx:id="avatarOpt4" fill="#e3f2fd" radius="35.0" stroke="transparent" strokeType="INSIDE" strokeWidth="2.0" />
                                            </graphic>
                                        </Button>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <VBox spacing="15.0" style="-fx-background-color: rgba(255, 255, 255, 0.25); -fx-background-radius: 20; -fx-border-color: rgba(224, 224, 224, 0.5); -fx-border-radius: 20; -fx-padding: 20.0;">
                            <children>
                                <Label text="Select Wallpaper" textFill="black">
                                    <font>
                                        <Font name="System Bold" size="16.0" />
                                    </font>
                                </Label>

                                <HBox alignment="CENTER_LEFT" spacing="15.0">
                                    <children>
                                        <Button fx:id="wallpaper1" mnemonicParsing="false" onAction="#handleWallpaperSelection" prefHeight="70.0" prefWidth="120.0" style="-fx-background-color: #ABD8FF; -fx-background-radius: 10; -fx-border-color: #0078fe; -fx-border-radius: 10; -fx-border-width: 2.0; -fx-cursor: hand;" textFill="white">
                                            <font><Font name="System Bold" size="12.0" /></font>
                                        </Button>

                                        <Button fx:id="wallpaper2" mnemonicParsing="false" onAction="#handleWallpaperSelection" prefHeight="70.0" prefWidth="120.0" style="-fx-background-color: #2e7d32; -fx-background-radius: 10; -fx-border-color: transparent; -fx-border-radius: 10; -fx-border-width: 2.0; -fx-cursor: hand;" textFill="white">
                                            <font><Font name="System Bold" size="12.0" /></font>
                                        </Button>

                                        <Button fx:id="wallpaper3" mnemonicParsing="false" onAction="#handleWallpaperSelection" prefHeight="70.0" prefWidth="120.0" style="-fx-background-color: #c62828; -fx-background-radius: 10; -fx-border-color: transparent; -fx-border-radius: 10; -fx-border-width: 2.0; -fx-cursor: hand;" textFill="white">
                                            <font><Font name="System Bold" size="12.0" /></font>
                                        </Button>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </children>
</AnchorPane>
