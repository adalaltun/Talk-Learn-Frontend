<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.text.Font?>

<AnchorPane style="-fx-background-color: transparent; -fx-border-color: transparent #e0e0e0 transparent transparent; -fx-cursor: hand;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.SmallListingController">
   <children>
      <StackPane fx:id="discoveryListing" maxWidth="10000.0" prefHeight="50.0" style="-fx-background-color: transparent; -fx-border-color: transparent #e0e0e0 transparent transparent;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <HBox alignment="CENTER" maxWidth="10000.0" prefHeight="48.0" spacing="10.0" style="-fx-background-color: #0078fe; -fx-border-color: transparent #e0e0e0 transparent transparent; -fx-background-radius: 10; -fx-cursor: hand;">
               <children>
                  <Label fx:id="listingTitle" layoutX="11.0" layoutY="11.0" maxWidth="10000.0" prefHeight="50.0" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16;" text="tempTitle" HBox.hgrow="ALWAYS">
                     <font>
                        <Font size="14.0" />
                     </font>
                     <padding>
                        <Insets left="10.0" />
                     </padding>
                  </Label>
                  <Label fx:id="listingLanguage" alignment="CENTER" layoutX="212.0" layoutY="11.0" maxWidth="10000.0" prefHeight="50.0" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16;" text="tempLang" HBox.hgrow="ALWAYS">
                     <font>
                        <Font size="14.0" />
                     </font>
                  </Label>
                  <Label fx:id="listingRank" alignment="CENTER_RIGHT" layoutX="673.0" layoutY="11.0" maxWidth="10000.0" prefHeight="50.0" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16;" text="tempRank" HBox.hgrow="ALWAYS">
                     <font>
                        <Font size="14.0" />
                     </font>
                     <HBox.margin>
                        <Insets right="10.0" />
                     </HBox.margin>
                  </Label>
               </children>
               <StackPane.margin>
                  <Insets />
               </StackPane.margin>
            </HBox>
            <Button fx:id="listingButton" alignment="CENTER" blendMode="ADD" maxWidth="10000.0" mnemonicParsing="false" onAction="#handleListing" opacity="0.0" prefHeight="50.0" style="-fx-background-color: transparent; -fx-border-color: transparent #e0e0e0 transparent transparent;" text="(Invisible) Listing" />
         </children>
      </StackPane>
   </children>
</AnchorPane>
